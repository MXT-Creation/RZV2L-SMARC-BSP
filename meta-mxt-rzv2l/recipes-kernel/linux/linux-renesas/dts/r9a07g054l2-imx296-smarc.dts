/dts-v1/;
#include "r9a07g054l2-mxt-smarc.dts"

/ {
	avdd_cam_supply: 3p3v {
		compatible = "regulator-fixed";
		regulator-name = "avdd_cam_supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pinctrl RZG2L_GPIO(10, 0) 0>;
		startup-delay-us = <300000>;
	};
};

&clk_ext_camera {
	compatible = "fixed-clock";
	#clock-cells = <0>;
	clock-frequency = <37125000>;
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";

	imx296: imx296@1a {
		compatible = "sony,imx296";
		reg = <0x1a>;
		clock-names = "inck";
		clocks = <&clk_ext_camera>;
		clock-frequency = <37125000>;
		avdd-supply = <&avdd_cam_supply>;

		port {
			cam1_to_csi: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&csi2_in>;
			};
		};
	};

	/delete-node/ camera@3c;
};

&csi2 {
	status = "okay";

	ports {
		port {
			csi2_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1>;
				remote-endpoint = <&cam1_to_csi>;
			};
		};
	};
};

