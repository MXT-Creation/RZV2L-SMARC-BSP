/dts-v1/;
#include "r9a07g054l2-mxt-smarc.dts"

/ {
	camera_supply: 3p3v {
		compatible = "regulator-fixed";
		regulator-name = "camera_supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pinctrl RZG2L_GPIO(10, 0) 0>;
		startup-delay-us = <300000>;
		enable-active-high;
		regulator-always-on;
	};
};

&clk_ext_camera {
	compatible = "fixed-clock";
	#clock-cells = <0>;
	clock-frequency = <25000000>;
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";

	status = "okay";

	ov5647: camera@36 {
		compatible = "ovti,ov5647";
		reg = <0x36>;
		clock-names = "xclk";
		clocks = <&clk_ext_camera>;
		clock-frequency = <25000000>;
		pwdn-gpios = <&pinctrl RZG2L_GPIO(14, 1) GPIO_ACTIVE_LOW>;

		port {
			cam1_to_csi: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&csi2_in>;
			};
		};
	};

	/delete-node/ camera@3c;
};

&csi2 {
	status = "okay";

	ports {
		port {
			csi2_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&cam1_to_csi>;
			};
		};
	};
};

